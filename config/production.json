{
  "shop": {
    "currency": "RSD",
    "language": "rs",
    "weightUnit": "kg"
  },
  "catalog": {
    "product": {
      "image": {
        "thumbnail": {
          "width": 300,
          "height": 300
        },
        "listing": {
          "width": 700,
          "height": 700
        },
        "single": {
          "width": 1200,
          "height": 1200
        }
      }
    },
    "showOutOfStockProduct": false
  },
  "system": {
    "theme": "jeftinko",
    "extensions": [
      {
        "name": "pages",
        "resolve": "extensions/pages",
        "enabled": true,
        "priority": 20
      },
      {
        "name": "product-old-price",
        "resolve": "extensions/product-old-price",
        "enabled": true,
        "priority": 30
      },
      {
        "name": "resend",
        "resolve": "extensions/resend",
        "enabled": true,
        "priority": 10
      },
      {
        "name": "product-sort-order",
        "resolve": "extensions/product-sort-order",
        "enabled": true,
        "priority": 40
      }
    ]
  },
  "resend": {
    "from": "Jeftinko <noreply@jeftinko.rs>",
    "admin_email": "savatic.nemanja@gmail.com",
    "admin_subject": "Nova porudžbina",
    "events": {
      "order_placed": {
        "subject": "Povrda porudžbine",
        "enabled": true,
        "templatePath": "config/emails/order_confirmation.html"
      },
      "order_admin_notifier": {
        "templatePath": "config/emails/order_admin_notifier.html"
      },
      "reset_password": {
        "subject": "Promeni lozinku",
        "enabled": true,
        "templatePath": "config/emails/reset_password.html"
      },
      "customer_registered": {
        "subject": "Dobrodošli u Jeftinko svet!",
        "enabled": true,
        "templatePath": "config/emails/welcome.html"
      }
    }
  },
  "oms": {
    "carriers": {
      "bex": {
        "name": "BEX",
        "trackingUrl": "https://bexexpress.rs/pracenje-posiljke"
      },
      "postexpress": {
        "name": "PostExpress",
        "trackingUrl": "https://www.posta.rs/lat/alati/pracenje-posiljke.aspx"
      },
      "dexpress": {
        "name": "DExpress",
        "trackingUrl": "https://www.dexpress.rs/rs/pracenje-posiljaka/{trackingNumber}"
      }
    }
  }
}
