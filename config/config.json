{
    "shop" : {
        "currency": "RSD",
        "language": "rs",
        "weightUnit": "kg"
    },   
    "catalog": {
        "product": {
            "image": {
                "thumbnail": {
                    "width": 300,
                    "height": 300
                },
                "listing": {
                    "width": 700,
                    "height": 700
                },
                "single": {
                    "width": 1200,
                    "height": 1200
                }
            }
        },
        "showOutOfStockProduct": false
    },
    "system": {
        "theme": "jeftinko",
        "extensions": [
            {
                "name": "pages",
                "resolve": "extensions/pages",
                "enabled": true,
                "priority": 20
            },
            {
                "name": "resend",
                "resolve": "node_modules/@evershop/resend",
                "enabled": true,
                "priority": 10
            }
        ]
    },
    "resend": {
    "from": "Jeftinko <noreply@jeftinko.rs>",
    "events": {
      "order_placed": {
        "subject": "Povrda porudžbine",
        "enabled": true,
        "templatePath": "config/emails/order_confirmation.html"
      },
      "reset_password": {
        "subject": "Promeni lozinku",
        "enabled": true,
        "templatePath": "config/emails/reset_password.html"
      },
      "customer_registered": {
        "subject": "Dobrodošli u Jeftinko svet!",
        "enabled": true,
        "templatePath": "config/emails/welcome.html"
      }
    }
  }
}